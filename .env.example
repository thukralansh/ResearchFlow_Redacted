# Runtime mode: local, internal, or external.
# External mode cannot start with the fixed development actor.
ENVIRONMENT_MODE=local
PERSISTENCE_ENVIRONMENT=local
DATABASE_CONNECTION_MODE=direct

# Local Supabase defaults. Replace only in an untracked .env file.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# Disposable test Supabase stack; never point this at the durable stack above.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:55322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PROJECT_REF=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=researchflow-sources
# Internal source objects use projects/{project_id}/sources/{source_id}/{sha256}.pdf.
# The external security gate later adds authenticated owner isolation.

# SQLAlchemy pool and PostgreSQL timeout defaults.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Optional on the deterministic fake path.
GITHUB_TOKEN=
REPOSITORY_TREE_ENTRY_LIMIT=5000
REPOSITORY_FILE_INSPECTION_LIMIT=20
REPOSITORY_MAX_FILE_BYTES=262144
REPOSITORY_DISCOVERY_VERSION=rf-structural-discovery-v1
REPOSITORY_STAGE_B_CANDIDATE_LIMIT=30
REPOSITORY_STAGE_B_INSPECTION_LIMIT=12
REPOSITORY_STAGE_B_AGGREGATE_BYTES=3145728
REPOSITORY_RANKING_VERSION=rf-repository-ranking-v1
REPOSITORY_ANALYSIS_VERSION=rf-python-symbols-v1
LLM_API_KEY=
LLM_PROVIDER=fake
LLM_MODEL=fake-v1
LLM_POLICY_VERSION=fake-policy-v1
LLM_REASONING_VERSION=fake-reasoning-v1
LLM_TEMPERATURE=0
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_STORE_RESPONSES=false
LLM_MODEL_SNAPSHOT_PINNED=false
LLM_INPUT_COST_PER_MILLION_USD=2
LLM_OUTPUT_COST_PER_MILLION_USD=12
MAX_GENERATION_CONTEXT_BYTES=1048576

# Real extraction is explicit and fails closed without a key.
# baseline is: LLM_PROVIDER=openai, LLM_MODEL=gpt-5.6-terra,
# LLM_POLICY_VERSION=openai-responses-terra-v1, LLM_REASONING_VERSION=medium,
# LLM_INPUT_COST_PER_MILLION_USD=2, LLM_OUTPUT_COST_PER_MILLION_USD=12.
# Keep the API key only in the untracked .env file. No automatic provider/model
# fallback or SDK retry is enabled.

PROMPT_VERSION=v1
PARSER_VERSION=pymupdf-v1

# Configurable operational guards; workflows persist the limits they use.
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=500
REPOSITORY_TREE_ENTRY_LIMIT=10000
REPOSITORY_FILE_INSPECTION_LIMIT=20

LOG_LEVEL=INFO

# DEVELOPMENT_ACTOR_ID is generated once in researchflow.domain.actor.
# It is intentionally not configurable.
